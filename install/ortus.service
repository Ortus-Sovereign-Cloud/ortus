# Ortus on one machine. Installed by install.sh; settings in /etc/ortus.
[Unit]
Description=Ortus
Documentation=https://github.com/Ortus-Sovereign-Cloud/ortus
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=ortus
Group=ortus
Environment=ORTUS_CONFIG=/etc/ortus/ortus.toml
EnvironmentFile=-/etc/ortus/ortus.env
ExecStart=/usr/local/bin/ortus serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
# An empty working directory: the program never serves files from it.
RuntimeDirectory=ortus
WorkingDirectory=/run/ortus
StateDirectory=ortus
StateDirectoryMode=0750
UMask=0027
LimitNOFILE=65536
# The mail role listens on ports 25, 465, 587 and 993.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ortus
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
